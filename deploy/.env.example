# Copied to .env by init.sh. Edit, then `docker compose up -d`.

# Address the service ports bind to on this host. 127.0.0.1 = this machine only.
# For a LAN/tailnet server use that interface's address AND firewall the ports.
OMNIX_BIND=127.0.0.1

# Models the one-shot `models` service pulls (space-separated). Pick a chat
# model that fits your GPU memory (see HELP.md); keep the embedding model.
OMNIX_MODELS=qwen3:8b nomic-embed-text

# kb-core
KB_CORE_EMBED_MODEL=nomic-embed-text
# Chat model for fact extraction/contradiction checks (empty = off).
KB_CORE_LLM_MODEL=qwen3:8b
KB_CORE_USER_NAME=
# Notes folder to index, read-only (an Obsidian vault is detected automatically).
OMNIX_NOTES_DIR=./notes

# NVIDIA override only: GPU index for each service.
OMNIX_OLLAMA_GPU=0
OMNIX_STT_GPU=0
