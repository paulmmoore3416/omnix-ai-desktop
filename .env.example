# ---------------------------------------------------------------------------
# Developer-only environment variables.
#
# The OMNIX app itself does NOT read .env. All user configuration lives in
# Settings (settings.json in your config directory) and API keys live in the
# OS keychain. Never put API keys in this file.
#
# Nothing loads this file automatically: export the variables in your shell
# (e.g. `set -a; . ./.env; set +a`) before running `npm run tauri dev`.
# ---------------------------------------------------------------------------

# Rust log filter for `npm run tauri dev` (tracing EnvFilter syntax).
# Examples: info | debug | omnix_lib=debug,info
RUST_LOG=info

# Expose the Vite dev server on another interface (e.g. to debug on a phone or
# second machine). Leave unset for localhost-only development.
# TAURI_DEV_HOST=192.168.1.50
